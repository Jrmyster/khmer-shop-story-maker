{
  "name": "khmer-shop-story-maker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:cloudflare": "npx --yes wrangler@4.148.0 deploy --config wrangler.json",
    "deploy:cloudflare:check": "npx --yes wrangler@4.148.0 deploy --config wrangler.json --dry-run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src tests scripts docs README.md *.json *.ts *.js .github"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.11.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "27.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "7.3.6",
    "vitest": "4.0.18"
  }
}
